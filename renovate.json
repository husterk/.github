{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>husterk/.github//renovate/default",
    "github>husterk/.github//renovate/mise"
  ],
  "github-actions": {
    "managerFilePatterns": ["/^templates/pr-policy\\.yml$/"]
  },
  "renovate-config": {
    "managerFilePatterns": ["/^templates/renovate\\.json$/"]
  },
  "packageRules": [
    {
      "description": "Update the mise CLI on its own, so a breaking release fails a PR that changes nothing else",
      "matchDepNames": ["jdx/mise"],
      "groupName": "mise CLI"
    }
  ]
}
