{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Base Renovate config for husterk's repositories",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "group:allNonMajor"
  ],
  "labels": ["dependencies"],
  "rangeStrategy": "pin",
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "rebaseWhen": "conflicted",
  "schedule": ["* 0-5 1 * *"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-5 1 * *"]
  },
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["dependencies", "security"],
    "schedule": ["* 0-5 1,15 * *"]
  },
  "packageRules": [
    {
      "description": "One PR per husterk/.github release, covering the presets and the action, opened without waiting for the schedule",
      "matchDepNames": ["husterk/.github"],
      "groupName": "husterk .github",
      "schedule": ["at any time"],
      "separateMajorMinor": false
    }
  ]
}
